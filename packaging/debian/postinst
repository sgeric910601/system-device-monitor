#!/bin/sh
# 系統與裝置監看：安裝或升級後重新載入 systemd。從不自動啟用任何服務；
# 只有使用者先前已經開啟 CPU 功耗取樣（socket 已啟用）時，才重新啟動 socket 套用新的單元檔。
# DPKG_ROOT 不是空的（以 dpkg --root 安裝到其他目錄）時不碰執行中的 systemd。
set -e

SOCKET=system-device-monitor-cpu-power.socket
SERVICE=system-device-monitor-cpu-power.service
LOCAL_HELPER=/usr/local/libexec/system-device-monitor/sdm-cpu-power

if [ "$1" = "configure" ]; then
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        if systemctl --quiet is-enabled "$SOCKET" 2>/dev/null; then
            systemctl stop "$SERVICE" >/dev/null 2>&1 || true
            systemctl restart "$SOCKET" >/dev/null 2>&1 || true
        fi
    fi
    if [ -e "${DPKG_ROOT:-}$LOCAL_HELPER" ]; then
        # 只警告：套件已安裝時原始碼版的移除會拒絕執行（兩者共用無人授權的規則與喚醒紀錄）
        echo "system-device-monitor: 偵測到原始碼安裝的管理員元件；兩者擇一。要改用套件時，請先執行 sudo apt remove system-device-monitor，再在原始碼資料夾執行 install.py --system-components remove，之後重新安裝套件。" >&2
    fi
fi

exit 0
