#!/usr/bin/python3 -IB
"""系統與裝置監看：CPU 功耗取樣服務（由 systemd socket 啟動，Accept=no）。

從不以 root 執行：單元以 DynamicUser=yes 取得臨時帳號，沒有任何能力（CapabilityBoundingSet=
與 AmbientCapabilities= 都是空的）。只有 root 能讀的 RAPL 計數器由 systemd 以 OpenFile=（經過單元
啟動前在 /run/system-device-monitor 建立的符號連結，因為 systemd 255 的 OpenFile= 路徑不能有冒號）
唯讀開好，連同監聽 socket 一起交給服務：
1. 防禦性斷言：/proc/self/status 必須顯示不是 root、CapInh／CapPrm／CapEff／CapBnd／CapAmb
   全部為 0、NoNewPrivs 為 1，否則結束。
2. 依 LISTEN_FDNAMES 找出描述子：listen（正在監聽的 AF_UNIX 串流 socket，必須有）、
   package 與 core（energy_uj，可以沒有）；名稱或數量不符就結束。計數器描述子必須正是
   /sys/class/powercap 中對應區域的 energy_uj（/proc/self/fd 的開啟路徑相同，inode、權限、擁有者、
   大小、連結數與裝置的主編號也相同；服務的 /sys 因 PrivateNetwork=yes 重新掛載，次編號不同），
   區域名稱也要相符；
   計數上限（max_energy_range_uj，所有人可讀）直接讀取。之後只對這些描述子做 pread()。
3. 記下 socket 檔的擁有者（drop-in 的 SocketUser）。
4. 取樣與個別請求無關：1 秒刻度的相位在服務啟動時決定（啟動時間＋k 秒）；讀取只發生在
   刻度上，或處理請求時補上剛過去的刻度，請求本身不會讓服務在其他時間讀取。每個連線拿到的
   都是最近一個「已完成」的 1 秒視窗，數值四捨五入到 0.1 W。同一個帳號的客戶端可以等服務
   閒置 30 秒結束後重新連線、讓 systemd 重新啟動服務，藉此選擇新的相位，但拿到的仍然是
   1 秒、0.1 W 的平均。
5. 服務客戶端：只接受 socket 擁有者（或 root）；每個請求是一行「r」，回一行 JSON
   {"v":1,"status":"ok|sampling|error","package_w":x,"core_w":y,"interval_s":s}。
   其他任何輸入立即斷線；最多 2 個連線；每秒最多接受 4 個連線（超過時暫停接受）；
   30 秒沒有請求的連線會被關閉；沒有任何連線 30 秒後結束（下次連線時 systemd 再啟動）。
只使用標準函式庫；不執行外部程式，不寫入任何檔案。
"""
from collections import deque
import json
import math
import os
import selectors
import socket
import stat
import struct
import sys
import syslog
import time
from typing import NamedTuple, Optional

PROTOCOL = 1
EXIT_OK, EXIT_USAGE, EXIT_FAILED, EXIT_NOT_PERMITTED = 0, 2, 3, 4
POWERCAP = "/sys/class/powercap"
PACKAGE_ZONE = "intel-rapl:0"           # 第一個處理器插槽
CORE_ZONE = "intel-rapl:0:0"            # 單元的 OpenFile= 經由符號連結固定開這兩個區域
PACKAGE_NAME = "package-0"
CORE_NAME = "core"
LISTEN_FD = 3                           # sd_listen_fds 的第一個描述子
LISTEN_VARIABLES = ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES")
FD_LISTEN, FD_PACKAGE, FD_CORE = "listen", "package", "core"   # 單元設定的描述子名稱
FD_NAMES = (FD_LISTEN, FD_PACKAGE, FD_CORE)
PROC_FD = "/proc/self/fd"                # 描述子的開啟路徑
STAT_FIELDS = ("st_ino", "st_mode", "st_uid", "st_gid", "st_size", "st_nlink")   # 必須相同的欄位
PROC_STATUS = "/proc/self/status"
CAPABILITY_FIELDS = ("CapInh", "CapPrm", "CapEff", "CapBnd", "CapAmb")
MICROJOULES = 1_000_000
MAX_WATTS = 1000                        # 與 sdm.constants.Power.COMPONENT_MAX_W 相同（不含）
MAX_WINDOW_S = 30.0                     # 兩次讀取最多相隔 30 秒（計數器最多只可能繞回一次）
PERIOD_S = 1.0                          # 全部連線共用的取樣刻度（秒）
MAX_CLIENTS = 2
ACCEPTS_PER_WINDOW = 4                  # 每個接受視窗最多接受幾個連線
ACCEPT_WINDOW_S = 1.0
IDLE_EXIT_S = 30.0                      # 沒有任何連線多久後結束
CLIENT_IDLE_S = 30.0                    # 連線多久沒有請求就關閉
WATTS_DIGITS = 1
INTERVAL_DIGITS = 2
COUNTER_BYTES = 32
COUNTER_MAX_DIGITS = 20
RECV_BYTES = 64
REQUEST = b"r\n"
COMPLETE, INCOMPLETE, INVALID = "complete", "incomplete", "invalid"
STATUS_OK, STATUS_SAMPLING, STATUS_ERROR = "ok", "sampling", "error"
PEERCRED = struct.Struct("iII")         # struct ucred：pid、uid、gid
LOG_IDENT = "sdm-cpu-power-service"


class Failure(Exception):
    """無法安全地啟動或繼續服務；訊息只含固定的英文代號。"""


class Channel(NamedTuple):
    fd: int                             # energy_uj 的唯讀描述子
    max_range: Optional[int]            # 計數上限（微焦耳）；讀不到時不處理繞回


class Ranges(NamedTuple):
    package: Optional[int]
    core: Optional[int]


class Sample(NamedTuple):
    stamp: float                        # 單調時鐘秒數
    package: Optional[int]              # 微焦耳
    core: Optional[int]


class Limits(NamedTuple):
    clients: int = MAX_CLIENTS
    idle_exit: float = IDLE_EXIT_S
    client_idle: float = CLIENT_IDLE_S
    period: float = PERIOD_S
    accepts: int = ACCEPTS_PER_WINDOW
    accept_window: float = ACCEPT_WINDOW_S


def log(message):
    syslog.openlog(LOG_IDENT, syslog.LOG_PID, syslog.LOG_DAEMON)
    syslog.syslog(syslog.LOG_INFO, message)


# ── 能量計數器 ──────────────────────────────────────────────

def parse_counter(data):
    """energy_uj 的內容：只接受十進位非負整數。"""
    text = data.strip()
    if not text or len(text) > COUNTER_MAX_DIGITS or not text.isdigit():
        return None
    return int(text)


def read_counter(fd):
    try:
        return parse_counter(os.pread(fd, COUNTER_BYTES, 0))
    except OSError:
        return None


def read_small(path):
    try:
        with open(path, "rb") as handle:
            return handle.read(COUNTER_BYTES)
    except OSError:
        return b""


def zone_name(path):
    return read_small(os.path.join(path, "name")).strip().decode("ascii", "replace")


def core_zone(base):
    """package 底下名稱為 core 的子區域；不存在或不只一個時為 None（不猜）。"""
    prefix = PACKAGE_ZONE + ":"
    try:
        entries = os.listdir(base)
    except OSError:
        return None
    matches = [os.path.join(base, entry) for entry in sorted(entries)
               if entry.startswith(prefix) and entry[len(prefix):].isdigit()
               and zone_name(os.path.join(base, entry)) == CORE_NAME]
    return matches[0] if len(matches) == 1 else None


def stats_match(opened, expected):
    """同一個一般檔案：inode、類型與權限、擁有者、大小、連結數與裝置的主編號都相同。

    PrivateNetwork=yes 讓服務的 /sys 重新掛載成另一個 sysfs，只有裝置的次編號不同（描述子是
    systemd 在原本的 /sys 開的），所以不比對次編號。sysfs 的主編號固定是 0，區分不了檔案系統，
    所以 same_file 另外比對開啟路徑。"""
    return stat.S_ISREG(opened.st_mode) and os.major(opened.st_dev) == os.major(expected.st_dev) \
        and all(getattr(opened, name) == getattr(expected, name) for name in STAT_FIELDS)


def same_file(fd, path):
    """描述子是不是 path 這個一般檔案：stat 欄位相符，而且核心記錄的開啟路徑（/proc/self/fd）
    就是 path 的真實路徑（排除同一個 inode 從別的路徑開啟，例如硬連結）。"""
    try:
        opened, expected = os.fstat(fd), os.stat(path)
        where = os.readlink(f"{PROC_FD}/{fd}")
    except OSError:
        return False
    return stats_match(opened, expected) and where == os.path.realpath(path)


def accept_channel(fd, base, zone, label):
    """systemd 交來的 energy_uj 描述子通過檢查時回傳 Channel，否則關閉它並回傳 None。"""
    if fd is None:
        return None
    directory = os.path.join(base, zone)
    if zone_name(directory) == label and same_file(fd, os.path.join(directory, "energy_uj")):
        max_range = parse_counter(read_small(os.path.join(directory, "max_energy_range_uj")))
        return Channel(fd, max_range)
    os.close(fd)
    return None


def channels_from(named, base=POWERCAP):
    """（package、core）；core 必須是唯一名為 core 的子區域，而且就是 intel-rapl:0:0。"""
    package = accept_channel(named.get(FD_PACKAGE), base, PACKAGE_ZONE, PACKAGE_NAME)
    core_fd = named.get(FD_CORE)
    if core_fd is not None and core_zone(base) != os.path.join(base, CORE_ZONE):
        os.close(core_fd)
        core_fd = None
    return package, accept_channel(core_fd, base, CORE_ZONE, CORE_NAME)


class Sampler:
    """讀取 systemd 交來的計數器描述子（服務本身沒有權限開啟它們，只能 pread）。"""

    def __init__(self, channels, clock=time.monotonic):
        self.package, self.core = channels
        self.clock = clock

    def __call__(self):
        stamp = self.clock()
        return Sample(stamp, read_counter(self.package.fd) if self.package else None,
                      read_counter(self.core.fd) if self.core else None)


# ── 能量差與瓦數 ────────────────────────────────────────────

def energy_delta(prior, current, max_range):
    """兩次讀值的能量差（微焦耳）；計數器變小時只在知道上限時視為繞回一次。"""
    if prior is None or current is None:
        return None
    if current >= prior:
        return current - prior
    if max_range is None or max_range <= prior:
        return None
    return max_range - prior + current


def to_watts(delta, elapsed):
    if delta is None:
        return None
    value = delta / MICROJOULES / elapsed
    if not math.isfinite(value) or not 0 <= value < MAX_WATTS:
        return None
    return round(value, WATTS_DIGITS)


def measure(previous, current, ranges):
    """（package W、core W、間隔秒數）；無法得到可信的 package 瓦數時為 None。"""
    elapsed = current.stamp - previous.stamp
    if not 0 < elapsed <= MAX_WINDOW_S:
        return None
    package = to_watts(energy_delta(previous.package, current.package, ranges.package), elapsed)
    if package is None:
        return None
    core = to_watts(energy_delta(previous.core, current.core, ranges.core), elapsed)
    if core is not None and core > package:
        core = None
    return package, core, round(elapsed, INTERVAL_DIGITS)


def reply(status, package_w=None, core_w=None, interval_s=None):
    body = {"v": PROTOCOL, "status": status, "package_w": package_w, "core_w": core_w,
            "interval_s": interval_s}
    return (json.dumps(body, separators=(",", ":")) + "\n").encode("ascii")


class WindowSampler:
    """在固定刻度（start＋k × period）讀計數器；reply 永遠是最近一個完成的視窗。

    落後超過一個刻度時（例如暫停過）只讀一次並回到原本的刻度上，間隔照實回報。
    """

    def __init__(self, take, ranges, start, period=PERIOD_S):
        self.take, self.ranges, self.period = take, ranges, period
        self.next_tick, self.previous = start, None
        self.reply = reply(STATUS_SAMPLING)

    def advance(self, now):
        if now < self.next_tick:
            return
        behind = int((now - self.next_tick) // self.period)
        self.next_tick += (behind + 1) * self.period
        current = self.take()
        if current.package is None:
            self.previous, self.reply = None, reply(STATUS_ERROR)
            return
        previous, self.previous = self.previous, current
        result = None if previous is None else measure(previous, current, self.ranges)
        self.reply = reply(STATUS_SAMPLING) if result is None else reply(STATUS_OK, *result)

    def timeout(self, now):
        return max(0.0, self.next_tick - now)


class AcceptLimiter:
    """滑動視窗：window 秒內最多接受 limit 個連線。"""

    def __init__(self, limit=ACCEPTS_PER_WINDOW, window=ACCEPT_WINDOW_S):
        self.limit, self.window, self.times = limit, window, deque()

    def allowed(self, now):
        while self.times and now - self.times[0] >= self.window:
            self.times.popleft()
        return len(self.times) < self.limit

    def record(self, now):
        self.times.append(now)

    def wait(self, now):
        return 0.0 if self.allowed(now) else self.times[0] + self.window - now


class Client:
    """一個連線：尚未完成的請求與最後一次請求的時間。"""

    def __init__(self, sock, now):
        self.sock, self.buffer, self.last_seen = sock, b"", now


def parse_request(buffer):
    """請求只有「r\\n」一種；之前的部分可以分段到達，其他一律無效。"""
    if buffer == REQUEST:
        return COMPLETE
    if REQUEST.startswith(buffer):
        return INCOMPLETE
    return INVALID


# ── 服務迴圈 ────────────────────────────────────────────────

def peer_uid(sock):
    return PEERCRED.unpack(sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                           PEERCRED.size))[1]


class Server:
    def __init__(self, listener, take, ranges, owner, limits=Limits(), clock=time.monotonic,
                 peer=peer_uid):
        self.listener, self.take, self.ranges, self.owner = listener, take, ranges, owner
        self.limits, self.clock, self.peer = limits, clock, peer
        now = clock()
        self.sampler = WindowSampler(take, ranges, now, limits.period)
        self.accepts = AcceptLimiter(limits.accepts, limits.accept_window)
        self.selector = selectors.DefaultSelector()
        self.clients, self.idle_since, self.listening = [], now, False

    def run(self):
        """服務到沒有任何連線超過 idle_exit 秒為止；回傳結束碼。"""
        self.listener.setblocking(False)
        while True:
            now = self.clock()
            self.sampler.advance(now)
            if not self.clients and now - self.idle_since >= self.limits.idle_exit:
                return EXIT_OK
            self.listen(self.accepts.allowed(now))
            for key, _ in self.selector.select(self.timeout(now)):
                if key.data is None:
                    self.accept()
                else:
                    self.handle(key.data)
            self.expire(self.clock())

    def listen(self, allowed):
        """超過接受速率時暫停監聽（連線留在核心的佇列裡），恢復時再監聽。"""
        if allowed and not self.listening:
            self.selector.register(self.listener, selectors.EVENT_READ, None)
        elif not allowed and self.listening:
            self.selector.unregister(self.listener)
        self.listening = allowed

    def timeout(self, now):
        deadlines = [self.sampler.timeout(now)]
        if not self.listening:
            deadlines.append(self.accepts.wait(now))
        if self.clients:
            oldest = min(client.last_seen for client in self.clients)
            deadlines.append(oldest + self.limits.client_idle - now)
        else:
            deadlines.append(self.idle_since + self.limits.idle_exit - now)
        return max(0.0, min(deadlines))

    def allowed(self, sock):
        try:
            uid = self.peer(sock)
        except OSError:
            return False
        return self.owner is not None and uid in (self.owner, 0)

    def accept(self):
        try:
            sock, _ = self.listener.accept()
        except OSError:
            return
        now = self.clock()
        self.accepts.record(now)
        if len(self.clients) >= self.limits.clients or not self.allowed(sock):
            sock.close()
            return
        sock.setblocking(False)
        client = Client(sock, now)
        self.clients.append(client)
        self.selector.register(sock, selectors.EVENT_READ, client)

    def handle(self, client):
        try:
            data = client.sock.recv(RECV_BYTES)
        except (BlockingIOError, InterruptedError):
            return
        except OSError:
            data = b""
        state = parse_request(client.buffer + data) if data else INVALID
        if state == INVALID:
            self.drop(client)
            return
        client.buffer += data
        if state == INCOMPLETE:
            return
        client.buffer, client.last_seen = b"", self.clock()
        self.sampler.advance(client.last_seen)
        payload = self.sampler.reply
        try:
            sent = client.sock.send(payload)
        except OSError:
            sent = 0
        if sent != len(payload):
            self.drop(client)

    def expire(self, now):
        for client in [c for c in self.clients if now - c.last_seen >= self.limits.client_idle]:
            self.drop(client)

    def drop(self, client):
        if client.sock.fileno() >= 0 and client in self.clients:
            try:
                self.selector.unregister(client.sock)
            except (KeyError, ValueError):
                pass
        client.sock.close()
        if client in self.clients:
            self.clients.remove(client)
        if not self.clients:
            self.idle_since = self.clock()

    def close(self):
        for client in list(self.clients):
            self.drop(client)
        self.selector.close()
        self.listener.close()


# ── 啟動：權限斷言、systemd 交來的描述子 ─────────────────────────

def privilege_problem(status_text):
    """不是 root、沒有任何能力、禁止取得新權限時回傳 None；否則回傳問題代號。"""
    fields = {}
    for line in status_text.splitlines():
        key, separator, value = line.partition(":")
        if separator:
            fields[key] = value.split()
    uids = fields.get("Uid", [])
    if len(uids) != 4 or not all(uid.isdigit() and int(uid) != 0 for uid in uids):
        return "root"
    for name in CAPABILITY_FIELDS:
        value = fields.get(name, [])
        try:
            if len(value) != 1 or int(value[0], 16) != 0:
                return "capabilities"
        except ValueError:
            return "capabilities"
    if fields.get("NoNewPrivs") != ["1"]:
        return "no-new-privileges"
    return None


def read_proc_status():
    with open(PROC_STATUS, encoding="ascii", errors="replace") as handle:
        return handle.read()


def inherited_fds(env, pid, fds=None, inherit=lambda fd: os.set_inheritable(fd, False)):
    """名稱 → 描述子；LISTEN_PID、LISTEN_FDS 與 LISTEN_FDNAMES 必須一致，成功時清除它們。"""
    count = env.get("LISTEN_FDS", "")
    names = env.get("LISTEN_FDNAMES", "").split(":")
    if env.get("LISTEN_PID") != str(pid) or not count.isdigit() or int(count) != len(names) \
            or len(set(names)) != len(names) or not set(names) <= set(FD_NAMES) \
            or FD_LISTEN not in names:
        raise Failure("descriptors")
    fds = list(range(LISTEN_FD, LISTEN_FD + len(names)) if fds is None else fds)[:len(names)]
    for name in LISTEN_VARIABLES:
        env.pop(name, None)
    for fd in fds:
        inherit(fd)
    return dict(zip(names, fds))


def listening_socket(fd):
    """正在監聽的 AF_UNIX 串流 socket；不是就拋出 Failure（描述子留給呼叫端關閉）。"""
    try:
        if not stat.S_ISSOCK(os.fstat(fd).st_mode):
            raise Failure("not-a-socket")
        sock = socket.socket(fileno=fd)
    except OSError:
        raise Failure("not-a-socket") from None
    try:
        listening = sock.getsockopt(socket.SOL_SOCKET, socket.SO_ACCEPTCONN)
    except OSError:
        listening = 0
    if sock.family != socket.AF_UNIX or sock.type != socket.SOCK_STREAM or not listening:
        sock.detach()
        raise Failure("wrong-socket")
    return sock


def socket_owner(listener):
    """監聽 socket 檔的擁有者 uid（drop-in 的 SocketUser）；不是檔案系統 socket 時為 None。"""
    name = listener.getsockname()
    if not isinstance(name, str) or not name.startswith("/"):
        return None
    try:
        return os.stat(name).st_uid
    except OSError:
        return None


def close_all(fds):
    for fd in fds:
        try:
            os.close(fd)
        except OSError:
            pass


def prepare(env, pid, base, fds=None):
    """依名稱取得監聽 socket 與計數器；失敗時關閉所有交來的描述子。"""
    named = inherited_fds(env, pid, fds)
    try:
        listener = listening_socket(named[FD_LISTEN])
    except Failure:
        close_all(named.values())
        raise
    try:
        owner = socket_owner(listener)
        channels = channels_from(named, base)
    except BaseException:
        listener.close()
        close_all(fd for name, fd in named.items() if name != FD_LISTEN)
        raise
    ranges = Ranges(*(channel.max_range if channel else None for channel in channels))
    return Server(listener, Sampler(channels), ranges, owner)


def start(env, pid=None):
    """實際啟動：systemd 交來的描述子與 /sys/class/powercap。"""
    server = prepare(env, os.getpid() if pid is None else pid, POWERCAP)
    log("started" if server.take().package is not None else "started without rapl")
    code = server.run()
    log("idle exit")
    return code


def emit_json(value):
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def main(argv, env, read_status=read_proc_status, start=start, emit=emit_json, report=log):
    if argv:
        emit({"ok": False, "error": "usage"})
        return EXIT_USAGE
    try:
        problem = privilege_problem(read_status())
    except OSError:
        problem = "status"
    if problem is not None:
        report("refused: " + problem)
        emit({"ok": False, "error": "not-permitted"})
        return EXIT_NOT_PERMITTED
    try:
        return start(env)
    except (Failure, OSError) as error:
        report("failed: " + (str(error) if isinstance(error, Failure) else type(error).__name__))
        emit({"ok": False, "error": "failed"})
        return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], os.environ))
