# 系統與裝置監看：CPU 功耗取樣服務，只由同名的 socket 啟動（沒有 [Install]）。
# 從不以 root 執行：DynamicUser 的臨時帳號，沒有任何能力。只有 root 能讀的 RAPL 計數器
# 由 systemd 以 OpenFile= 唯讀開好交給服務（路徑中的冒號寫成 \x3a）；讀不到時略過。
# 沒有網路、看不到其他程序與家目錄，整個檔案系統唯讀。
[Unit]
Description=System Device Monitor CPU power sampler
Requires=system-device-monitor-cpu-power.socket
After=system-device-monitor-cpu-power.socket

[Service]
Type=simple
ExecStart=/usr/libexec/system-device-monitor/sdm-cpu-power-service
DynamicUser=yes
User=sdm-cpu-power
OpenFile=/sys/class/powercap/intel-rapl\x3a0/energy_uj:package:read-only,graceful
OpenFile=/sys/class/powercap/intel-rapl\x3a0\x3a0/energy_uj:core:read-only,graceful
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallFilter=~@resources
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
MemoryMax=64M
TasksMax=4
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
