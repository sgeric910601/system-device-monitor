# 系統與裝置監看：開機與睡眠喚醒後重新套用使用者選擇保留的充電上限。
# 套件安裝時不啟用；使用者在「電源」頁開啟「開機與喚醒後保留」並通過管理員授權後，
# sdm-charge-limit set … --persist on 才寫入狀態檔並啟用這個單元，--persist off 時停用。
# restore 只讀狀態檔、重新寫入同一顆電池的門檻，不執行任何外部程式。
# 以 root 執行（sysfs 的門檻檔屬於 root），但沒有任何能力；只有 /sys/devices 可寫
# （/sys/class/power_supply 底下只是指向 /sys/devices 的符號連結），
# 其他檔案系統唯讀（小程式的鎖檔所在的 /run/system-device-monitor 除外），
# 沒有網路，看不到家目錄與其他程序。
[Unit]
Description=System Device Monitor charge limit restore
After=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
ConditionPathExists=/var/lib/system-device-monitor/charge-limit-local.json

[Service]
Type=oneshot
# 重新套用通常不到 1 秒；卡住時由 systemd 在 30 秒後結束，不會拖住開機或喚醒
TimeoutStartSec=30s
TimeoutStopSec=10s
ExecStart=/usr/local/libexec/system-device-monitor/sdm-charge-limit restore --from-unit
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateNetwork=yes
IPAddressDeny=any
PrivateDevices=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectSystem=strict
ReadWritePaths=/sys/devices
# 小程式的鎖檔在 /run/system-device-monitor（與 CPU 功耗的 socket 共用），停止時不刪除
RuntimeDirectory=system-device-monitor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
MemoryMax=64M
TasksMax=4
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target sleep.target
