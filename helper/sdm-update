DPKG_LOCK = "var/lib/dpkg/lock-frontend"                    # 相對於根目錄
STAGING = ("var/cache", "system-device-monitor", "staging")  # 同上；後兩層不存在時建立
LOCK_TIMEOUT_S, LOCK_POLL_S = 120, 1     # 等 dpkg 前端鎖的上限與間隔（秒）
APT_TIMEOUT_S = 30 * 60         # apt-get 的時限；超過時只送 SIGTERM 給它的程序群組，絕不送 SIGKILL
APT_TERM_WAIT_S = 60            # 送出 SIGTERM 後再等的時間；仍未結束就讓它自己完成
COMMAND_TIMEOUT_S = 60
PREPARE_TIMEOUT_S = 240         # 從開始到檢查完套件內容的上限；之後是鎖與 apt-get 各自的逾時
MAX_OUTPUT_BYTES = 4 * 1024 * 1024
MAX_ENTRIES = 20000
CHUNK_BYTES = 1024 * 1024
UID_PATTERN = re.compile(r"[1-9][0-9]{0,9}")
